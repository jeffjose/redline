{
	"name": "redline",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22.17.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && TSGO_BIN=node_modules/.bin/tsrs svelte-check-native --tsconfig ./tsconfig.json",
		"check:slow": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"autoprefixer": "^10.6.1",
		"postcss": "^8.5.31",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-check-native": "^1.10.0",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@lucide/svelte": "^0.515.0",
		"clsx": "^2.1.1",
		"tailwind-merge": "^2.6.1",
		"tailwind-variants": "^0.2.1"
	}
}
